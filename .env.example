# ── Vyntric Support ────────────────────────────────────────────────
# Required
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_server_id

# Optional branding overrides (leave empty to use the bot avatar + bundled banner)
# BRAND_ICON_URL=https://cdn.example.com/vyntric-logo.png
# BRAND_BANNER_URL=https://cdn.example.com/vyntric-banner.png

# Optional: where ticket data + transcripts are stored (default ./data)
# DATA_DIR=./data

# Optional: where the Vyntric Tiers website data file lives (/settier writes it)
# Default: <drive>:\vyntric-tiers-v8\assets\data.json
TIERS_DATA_JSON=

# Optional: the Vyntric Tiers website data file that /tier set and /hightest write.
# Default: <drive>:\vyntric-tiers-v8\assets\data.json
# TIERS_DATA_JSON=

# ── Vyntric Tiers ───────────────────────────────────────────────────────────
# No secrets are needed for the tier system. Every write is gated on a Discord
# role (Tiers Tester and above), and the bot's own role has to sit above the
# staff roles before it can grant them. Run `/tester setup` to create them.
#
# The bot's Discord role needs, at minimum:
#   Manage Roles   - to grant the Tiers Tester role and apply `Restricted`
#   Manage Channels- only if you want it to create channels for you
# No Administrator permission is required or requested anywhere.
